# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Regenerable test fixtures — every legacy test writes its own CSV/JSON at
# runtime (see CLAUDE.md); the perf fixtures are regenerated by
# legacy/generate-perf-fixtures.js. None of this belongs in git.
legacy/test-*.csv
legacy/hist-*.csv
legacy/dl-*.csv
legacy/test-*.json
legacy/perf-test-*.csv

# Packaged build outputs — all regenerable from source (see legacy/README
# instructions and legacy/package.json's "build" script). Keeping these out
# of git avoids committing binary duplicates of what's already in the repo.
legacy/extension/*.zip
legacy/wired-cio-unified-scanner-source.zip
*.zip

# OS/editor cruft
.DS_Store
*.log
