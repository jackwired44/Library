{
  "name": "wired-cio-call-followups",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone tool: pull Apollo calls by rep, disposition and date, and draft the follow-up email from each call. See README.md.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/suites/followups.cjs",
    "test": "npm run build && node scripts/run-suites.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
